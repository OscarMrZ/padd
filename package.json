{
  "name": "padd",
  "version": "0.1.0",
  "private": true,
  "description": "Draw feedback for Claude Code sessions from a tablet",
  "type": "module",
  "bin": {
    "padd": "src/cli.ts"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p ui",
    "check": "tsc -p . && tsc -p ui --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "serve": "npm run build && node src/cli.ts serve"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
